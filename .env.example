# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real keys.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" key (or the newer "publishable" key). Safe in the browser:
# it can only do what Row Level Security allows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses Row Level Security — used for vendor document
# uploads. Never prefix with NEXT_PUBLIC_, never log it, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site, used in email links in production.
# On localhost, links automatically use the port the app is running on.
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Password recovery needs working email (SMTP). Leave false to keep the
# forgot/reset password screens as a static preview.
NEXT_PUBLIC_ENABLE_PASSWORD_RECOVERY=false
